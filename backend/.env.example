# =============================================================================
# BACKEND ENVIRONMENT VARIABLES — copy this to .env for local dev
# On Render: set these in Dashboard → your service → Environment
# =============================================================================

# REQUIRED — MongoDB Atlas connection string
# Atlas → Cluster → Connect → Drivers → copy URI, replace <password>
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ganesha-festival?retryWrites=true&w=majority&appName=Cluster0

# REQUIRED — Your Vercel frontend URL (used for CORS allow-list)
# Comma-separate if you have a custom domain too:
#   CLIENT_URL=https://ganesha-festival.vercel.app,https://www.yourdomain.com
CLIENT_URL=https://your-app.vercel.app

# Set automatically by Render — do NOT override in production
# PORT=5000

# Set automatically by the start script — do NOT override in production
# NODE_ENV=production
