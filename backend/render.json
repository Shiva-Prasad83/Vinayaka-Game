{
  "services": [
    {
      "type": "web",
      "name": "ganesha-festival-api",
      "runtime": "node",
      "region": "singapore",
      "plan": "free",
      "buildCommand": "npm install --omit=dev",
      "startCommand": "npm start",
      "healthCheckPath": "/api/health",
      "autoDeploy": true,
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "MONGO_URI",
          "generateValue": false
        },
        {
          "key": "CLIENT_URL",
          "generateValue": false
        }
      ]
    }
  ]
}
