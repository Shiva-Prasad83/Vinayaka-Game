# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES — copy this to .env.local for local dev
# On Vercel: set these in Dashboard → your project → Settings → Environment Variables
# =============================================================================

# REQUIRED in production — full URL of your Render backend, no trailing slash
# Vercel Dashboard → Settings → Environment Variables → add for Production
VITE_API_URL=https://your-render-service-name.onrender.com

# Leave blank or omit for local dev — Vite proxy handles /api → localhost:5000
# VITE_API_URL=http://localhost:5000
